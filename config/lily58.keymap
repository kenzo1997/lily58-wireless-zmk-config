#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        test_36key_version {
            bindings = <
&trans  &trans  &trans          &trans            &trans          &trans                                 &trans       &trans           &trans             &trans           &trans           &trans
&trans  &kp Q   &kp W           &kp E             &kp R           &kp T                                  &kp Y        &kp U            &kp I              &kp O            &mt BACKSPACE P  &trans
&trans  &kp A   &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LEFT_WIN F  &mt LCTRL G                            &mt RCTRL H  &mt RIGHT_WIN J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &kp SEMI         &trans
&trans  &kp Z   &kp X           &kp C             &kp V           &kp B        &trans         &trans     &kp N        &kp M            &kp COMMA          &kp DOT          &kp FSLH         &trans
                                &trans            &trans          &mo 3        &lt 1 SPACE    &lt 1 RET  &mo 3        &trans           &trans
            >;
        };

        test_34key_layer2 {
            bindings = <
&trans  &trans     &trans     &trans    &trans     &trans                     &trans   &trans     &trans    &trans    &trans        &trans
&trans  &kp N1     &kp N2     &kp N3    &kp N4     &kp N5                     &kp N6   &kp N7     &kp N8    &kp N9    &kp NUMBER_0  &trans
&trans  &kp MINUS  &kp EQUAL  &kp LBKT  &kp LSHFT  &kp ESC                    &kp TAB  &kp LSHFT  &kp RBKT  &kp BSLH  &kp SEMI      &trans
&trans  &trans     &trans     &trans    &kp SQT    &trans   &trans    &trans  &trans   &kp GRAVE  &trans    &trans    &trans        &trans
                              &trans    &trans     &trans   &trans    &trans  &trans   &trans     &trans
            >;
        };

        test_34key_layer3 {
            bindings = <
&trans  &trans  &trans     &trans  &trans  &trans                      &trans  &trans    &trans    &trans     &trans  &trans
&trans  &trans  &kp PLUS   &kp N7  &kp N8  &kp N9                      &trans  &trans    &kp UP    &trans     &trans  &trans
&trans  &trans  &kp MINUS  &kp N4  &kp N5  &kp N6                      &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &trans  &kp STAR   &kp N1  &kp N2  &kp N3    &trans    &trans  &trans  &trans    &trans    &trans     &trans  &trans
                           &trans  &kp N0  &kp FSLH  &to 0     &trans  &trans  &trans    &trans
            >;
        };

        test34key_switch_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &to 2   &to 4   &to 5   &to 6   &to 7                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        test_34key_blender_layer_object {
            bindings = <
&trans  &trans     &trans     &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LSHFT  &kp LCTRL  &kp A   &kp G   &kp R                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp S      &kp TAB    &kp X   &kp D   &kp Z                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F3     &kp I      &kp N   &kp H   &kp Q   &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans
                              &trans  &trans  &mo 3   &kp LALT    &trans  &trans  &trans  &trans
            >;
        };

        test_34key_blender_layer_edit {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        test_34key_blender_layer_sculpt {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp R   &kp Z   &kp LCTRL  &kp G                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp K   &kp V   &kp LSHFT  &kp C                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &mo 3   &kp I   &kp T      &kp F   &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans     &trans  &kp LALT    &trans  &trans  &trans  &trans
            >;
        };

        test_34key_blender_layer_krita {
            bindings = <
&trans  &trans  &trans    &trans     &trans     &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &mo 3   &kp FSLH  &kp TAB    &kp LCTRL  &kp N                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp V   &kp Z     &kp LSHFT  &kp N5     &kp N2                         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp P     &kp B      &kp F      &kp E     &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
                          &trans     &trans     &kp LALT  &kp SPACE    &trans  &trans  &trans  &trans
            >;
        };
    };
};
