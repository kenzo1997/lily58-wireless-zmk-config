#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&trans      &trans          &trans          &trans              &trans            &trans                           &trans  &trans             &trans       &trans           &trans                   &trans
&kp TAB     &kp Q           &kp W           &kp E               &kp R             &kp T                            &kp Y   &kp U              &kp I        &kp O            &kp P                    &kp MINUS
&kp ESCAPE  &mt LEFT_ALT A  &mt LEFT_WIN S  &mt LEFT_CONTROL D  &mt LEFT_SHIFT F  &kp G                            &kp H   &mt RIGHT_SHIFT J  &mt RCTRL K  &mt RIGHT_GUI L  &mt RIGHT_ALT SEMICOLON  &kp SQT
&kp TILDE   &kp Z           &kp X           &kp C               &kp V             &kp B   &kp LBKT       &kp RBKT  &kp N   &kp M              &kp COMMA    &kp DOT          &kp FSLH                 &kp EQUAL
                                            &trans              &trans            &to 3   &lt 1 SPACE    &kp RET   &to 2   &trans             &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans                    &trans  &trans           &trans          &trans     &trans  &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4          &kp N5                    &kp N6  &kp N7           &kp N8          &kp N9     &kp N0  &trans
&trans  &trans  &trans  &trans  &kp LEFT_SHIFT  &trans                    &trans  &kp RIGHT_SHIFT  &kp UP_ARROW    &trans     &trans  &kp BACKSPACE
&trans  &trans  &trans  &trans  &trans          &trans  &trans    &trans  &trans  &kp LEFT         &kp DOWN_ARROW  &kp RIGHT  &trans  &trans
                        &trans  &trans          &trans  &trans    &trans  &trans  &trans           &trans
            >;
        };

        layer_5 {
            bindings = <
&kp NUMBER_1     &kp NUMBER_2     &kp NUMBER_3     &kp F3  &kp K  &kp M                                   &kp F7          &kp F8      &kp F9  &kp F10  &kp F11  &kp F12
&kp KP_NUMBER_1  &kp KP_NUMBER_3  &kp KP_NUMBER_7  &kp A   &kp S  &kp G                                   &bt BT_CLR_ALL  &sys_reset  &trans  &trans   &trans   &trans
&kp TAB          &kp KP_NUMBER_9  &kp H            &kp Z   &kp E  &kp B                                   &trans          &trans      &trans  &trans   &trans   &trans
&kp LCTRL        &kp N            &kp P            &kp X   &kp I  &kp R           &kp SPACE       &trans  &trans          &trans      &trans  &trans   &trans   &trans
                                                   &sl 0   &kp J  &kp LEFT_SHIFT  &kp LEFT_ALT    &trans  &trans          &trans      &trans
            >;
        };

        llll {
            bindings = <
&trans     &trans     &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans     &trans  &kp W   &trans  &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans     &kp A   &kp S   &kp D   &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&kp LCTRL  &kp LSHFT  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
                              &trans  &trans  &trans  &kp SPACE    &trans  &trans  &trans  &trans
            >;
        };

        test_36key_version {
            bindings = <
&trans  &trans  &trans          &trans            &trans          &trans                                 &trans       &trans           &trans             &trans           &trans           &trans
&trans  &kp Q   &kp W           &kp E             &kp R           &kp T                                  &kp Y        &kp U            &kp I              &kp O            &mt BACKSPACE P  &trans
&trans  &kp A   &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LEFT_WIN F  &mt LCTRL G                            &mt RCTRL H  &mt RIGHT_WIN J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &kp SEMI         &trans
&trans  &kp Z   &kp X           &kp C             &kp V           &kp B        &trans         &trans     &kp N        &kp M            &kp COMMA          &kp DOT          &kp FSLH         &trans
                                &trans            &trans          &mo 7        &lt 5 SPACE    &lt 5 RET  &mo 7        &trans           &trans
            >;
        };

        test_34key_layer2 {
            bindings = <
&trans  &trans     &trans     &trans    &trans     &trans                     &trans   &trans     &trans    &trans    &trans        &trans
&trans  &kp N1     &kp N2     &kp N3    &kp N4     &kp N5                     &kp N6   &kp N7     &kp N8    &kp N9    &kp NUMBER_0  &trans
&trans  &kp MINUS  &kp EQUAL  &kp LBKT  &kp LSHFT  &kp ESC                    &kp TAB  &kp LSHFT  &kp RBKT  &kp BSLH  &kp SEMI      &trans
&trans  &trans     &trans     &trans    &kp SQT    &trans   &trans    &trans  &trans   &kp GRAVE  &trans    &trans    &trans        &trans
                              &trans    &trans     &trans   &trans    &trans  &trans   &trans     &trans
            >;
        };

        test_34key_layer3 {
            bindings = <
&trans  &trans  &trans     &trans  &trans  &trans                      &trans  &trans    &trans    &trans     &trans  &trans
&trans  &trans  &kp PLUS   &kp N7  &kp N8  &kp N9                      &trans  &trans    &kp UP    &trans     &trans  &trans
&trans  &trans  &kp MINUS  &kp N4  &kp N5  &kp N6                      &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &trans  &kp STAR   &kp N1  &kp N2  &kp N3    &trans    &trans  &trans  &trans    &trans    &trans     &trans  &trans
                           &trans  &kp N0  &kp FSLH  &to 4     &trans  &trans  &trans    &trans
            >;
        };

        test34key_switch_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &to 6   &to 8   &to 9   &to 10  &to 11                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        test_34key_blender_layer_object {
            bindings = <
&trans  &trans     &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp E      &kp R   &kp I   &kp A   &kp D                        &kp F   &trans  &trans  &trans  &trans  &trans
&trans  &kp G      &kp K   &kp Z   &kp B   &kp LCTRL                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LSHFT  &kp N4  &kp N8  &kp N6  &kp N2     &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                           &trans  &kp F3  &trans     &trans    &trans  &trans  &trans  &trans
            >;
        };

        test_34key_blender_layer_edit {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        test_34key_blender_layer_sculpt {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        test_34key_blender_layer_krita {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
